# Copy to .env and fill in. .env is git-ignored.

# OpenSky Network API client credentials (OAuth2 client credentials flow).
# Create an API client from your OpenSky account page. Leave empty for anonymous access
# (much lower rate limits).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ingest-service defaults (command-line flags override these)
# INGEST_MODE=live
# INGEST_INTERVAL=15s
# INGEST_BBOX=8,102,23.5,117.5
# INGEST_RECORD=data/recordings/vn.jsonl
# INGEST_REPLAY_FILE=data/recordings/vn.jsonl
# INGEST_REPLAY_SPEED=1
# INGEST_REPLAY_LOOP=false
# INGEST_LOG_LEVEL=info

# Infrastructure (docker compose)
POSTGRES_USER=flights
POSTGRES_PASSWORD=flights
POSTGRES_DB=flights
# Change these if a local Postgres/Redis already uses the default ports.
POSTGRES_PORT=5432
REDIS_PORT=6379
